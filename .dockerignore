# The raw downloads and alternate builds are hundreds of MB. The runtime image
# ships only the validated Manhattan boundary used by the production service.
data/*
!data/nyc/
!data/nyc/**
data/nyc/horizon.legacy.npz

# Built inside the image, from source.
node_modules
web/node_modules
web/dist

# Never useful in a container.
.venv
.git
.ruff_cache
**/.pytest_cache
**/__pycache__
**/*.pyc
**/*.egg-info
web/tsconfig.tsbuildinfo

# The pipeline is not installed in the runtime image.
pipeline

# Docs and plans.
docs
*.md
!README.md
