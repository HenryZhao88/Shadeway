# Include runtime artifacts for OUT=data/<build>, including alternate borough
# builds. Raw downloads and auxiliary caches stay out of the build context.
data/*
!data/*/
data/*/*
!data/*/amenities.parquet
!data/*/buildings.parquet
!data/*/edges.parquet
!data/*/nodes.parquet
!data/*/samples.parquet
!data/*/trees.parquet
!data/*/horizon.npz

# Built inside the image, from source.
node_modules
web/node_modules
web/dist

# Never useful in a container.
.venv
.git
.ruff_cache
**/.pytest_cache
**/__pycache__
**/*.pyc
**/*.egg-info
web/tsconfig.tsbuildinfo

# The pipeline is not installed in the runtime image.
pipeline

# Docs and plans.
docs
*.md
!README.md
